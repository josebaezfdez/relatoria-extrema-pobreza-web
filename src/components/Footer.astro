---
import { footerNavigation, localeConfig, type Locale } from "@/data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = localeConfig[locale];
const ohchrUrl = `https://www.ohchr.org/${locale}/special-procedures/sr-poverty`;
---

<section class="complaint-section container" aria-labelledby="complaint-title">
  <div class="complaint-cta">
    <div>
      <p class="eyebrow">{strings.officialChannel}</p>
      <h2 id="complaint-title">{strings.complaint}</h2>
      <p>{strings.complaintNote}</p>
    </div>
    <a class="button" href="https://spsubmission.ohchr.org/">
      <span>{strings.officialMechanism}</span>
      <span class="button__icon" aria-hidden="true">↗</span>
    </a>
  </div>
</section>
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <section class="site-footer__brand">
        <p class="site-footer__mandate">{strings.mandatePeriod}</p>
        <h2>{strings.footerClaim}</h2>
        <p>{strings.disclaimer}</p>
      </section>
      <nav aria-label={strings.legalInformation}>
        <h3>{strings.information}</h3>
        <ul>
          {footerNavigation[locale].map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <section>
        <h3>{strings.officialContact}</h3>
        <address>
          <p><a href="mailto:hrc-sr-extremepoverty-diazgalan@un.org">hrc-sr-extremepoverty-diazgalan@un.org</a></p>
          <p><a href={ohchrUrl}>OHCHR ↗</a></p>
        </address>
      </section>
    </div>
    <div class="site-footer__bottom">
      <small class="site-footer__legal">
        <span>© 2026 Elena Carolina Díaz Galán</span>
        <span class="site-footer__separator" aria-hidden="true">|</span>
        <span>Todos los derechos reservados</span>
        <span class="site-footer__separator" aria-hidden="true">|</span>
        <span class="site-footer__credit">
          Designed by
          <a
            class="site-footer__creator"
            href="https://creaerte.com/"
          >
            creaerte.com
          </a>
        </span>
      </small>
      <a
        class="site-footer__partner"
        href="https://www.urjc.es/ceib"
        aria-label={strings.collaboration}
      >
        <picture>
          <source type="image/webp" srcset="/brand/ceib-logo.webp" />
          <img
            src="/brand/ceib-logo.png"
            alt={strings.collaboration}
            width="1000"
            height="206"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </a>
    </div>
  </div>
</footer>
