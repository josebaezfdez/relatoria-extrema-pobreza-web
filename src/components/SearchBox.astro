---
import type { Locale } from "@/data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  es: { label: "Buscar en el sitio", placeholder: "Informe, evento, ciudad…" },
  en: { label: "Search the website", placeholder: "Report, event, city…" },
  fr: { label: "Rechercher sur le site", placeholder: "Rapport, événement, ville…" },
}[locale];
---

<section class="prose" data-search-root data-locale={locale}>
  <label for="site-search"><strong>{copy.label}</strong></label>
  <input
    id="site-search"
    type="search"
    autocomplete="off"
    placeholder={copy.placeholder}
  />
  <p aria-live="polite" data-search-status></p>
  <ol data-search-results></ol>
</section>

<style>
  [data-search-root] {
    min-height: 28rem;
  }

  input {
    width: 100%;
    min-height: 3.5rem;
    margin-top: 0.65rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--ink-800);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink-950);
    font-size: var(--step-1);
  }

  [data-search-status] {
    color: var(--muted);
  }

  ol {
    padding-left: 1.25rem;
  }

  li + li {
    margin-top: 1rem;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-search-root]");
  const input = root?.querySelector<HTMLInputElement>("input");
  const status = root?.querySelector<HTMLElement>("[data-search-status]");
  const results = root?.querySelector<HTMLOListElement>("[data-search-results]");
  const locale = root?.dataset.locale || "es";
  const messages = {
    es: {
      minimum: "Escribe al menos dos caracteres.",
      searching: "Buscando…",
      results: (count: number) => `${count} resultados`,
      unavailable: "La búsqueda estará disponible en la versión compilada.",
    },
    en: {
      minimum: "Enter at least two characters.",
      searching: "Searching…",
      results: (count: number) => `${count} results`,
      unavailable: "Search will be available in the compiled version.",
    },
    fr: {
      minimum: "Saisissez au moins deux caractères.",
      searching: "Recherche…",
      results: (count: number) => `${count} résultats`,
      unavailable: "La recherche sera disponible dans la version compilée.",
    },
  };
  const copy = messages[locale as keyof typeof messages] || messages.es;

  type PagefindResult = {
    url: string;
    meta: { title?: string };
    excerpt?: string;
  };
  type PagefindApi = {
    options: (options: { language: string }) => Promise<void>;
    search: (query: string) => Promise<{
      results: { data: () => Promise<PagefindResult> }[];
    }>;
  };
  let pagefind: PagefindApi | null = null;
  async function ensurePagefind() {
    if (!pagefind) {
      // Pagefind writes this module after the Astro build.
      const dynamicImport = new Function("path", "return import(path)") as (path: string) => Promise<PagefindApi>;
      pagefind = await dynamicImport("/pagefind/pagefind.js");
      await pagefind.options({ language: locale });
    }
    return pagefind;
  }

  input?.addEventListener("input", async () => {
    const query = input.value.trim();
    if (!status || !results) return;
    if (query.length < 2) {
      status.textContent = copy.minimum;
      results.replaceChildren();
      return;
    }
    status.textContent = copy.searching;
    try {
      const api = await ensurePagefind();
      const search = await api.search(query);
      const entries = await Promise.all(search.results.slice(0, 12).map((result) => result.data()));
      results.replaceChildren(...entries.map((entry) => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = entry.url;
        link.textContent = entry.meta.title || entry.url;
        item.append(link);
        if (entry.excerpt) {
          const excerpt = document.createElement("p");
          excerpt.textContent = entry.excerpt.replace(/<[^>]*>/g, "");
          item.append(excerpt);
        }
        return item;
      }));
      status.textContent = copy.results(entries.length);
    } catch {
      status.textContent = copy.unavailable;
    }
  });
</script>
