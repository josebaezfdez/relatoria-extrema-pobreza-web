---
import { localeConfig, locales, navigation, type Locale, type LocalizedPaths } from "@/data/site";

interface Props {
  locale: Locale;
  currentPath: string;
  localizedPaths: LocalizedPaths;
}

const { locale, currentPath, localizedPaths } = Astro.props;
const strings = localeConfig[locale];
const isHome = currentPath === `/${locale}/`;
---

<a class="skip-link" href="#main">{strings.skip}</a>
<header class:list={["site-header", { "site-header--hero": isHome }]}>
  <div class="site-header__utility">
    <div class="site-header__utility-inner container">
      <span class="site-header__status">
        <span class="site-header__status-mark" aria-hidden="true"></span>
        {strings.status}
      </span>
      <nav class="language-switcher" aria-label={strings.languageSelector}>
        {locales.map((language, index) => (
          <>
            {index > 0 && <span aria-hidden="true">·</span>}
            <a
              href={localizedPaths[language]}
              lang={language}
              hreflang={language}
              aria-current={locale === language ? "true" : undefined}
              aria-label={localeConfig[language].label}
            >
              {localeConfig[language].short}
            </a>
          </>
        ))}
      </nav>
    </div>
  </div>
  <div class="site-header__main container">
    <a
      class="wordmark"
      href={strings.home}
      aria-label={`Elena Carolina Díaz Galán — ${strings.homeLabel}`}
    >
      <span class="wordmark__primary">Elena Carolina Díaz Galán</span>
      <span class="wordmark__secondary">
        {strings.fullSiteName}
      </span>
    </a>
    <div class="site-header__navigation">
      <nav class="site-nav" aria-label={strings.primaryNavigation}>
        <ul class="site-nav__list">
          {navigation[locale].map((item) => (
            <li><a href={item.href} aria-current={currentPath.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <details class="mobile-nav">
        <summary>
          <span class="mobile-nav__label">{strings.menu}</span>
          <span class="mobile-nav__icon" aria-hidden="true"></span>
        </summary>
        <nav aria-label={strings.mobileNavigation}>
          <ul class="site-nav__list">
            {navigation[locale].map((item) => (
              <li><a href={item.href} aria-current={currentPath.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
