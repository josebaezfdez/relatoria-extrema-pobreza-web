---
import { localeConfig, type Locale } from "@/data/site";

interface Props {
  locale: Locale;
  current: string;
}

const { locale, current } = Astro.props;
---

<nav class="breadcrumbs" aria-label={locale === "es" ? "Migas de pan" : locale === "fr" ? "Fil d’Ariane" : "Breadcrumb"}>
  <ol class="breadcrumbs__list container">
    <li><a href={`/${locale}/`}>{localeConfig[locale].homeLabel}</a></li>
    <li aria-current="page">{current}</li>
  </ol>
</nav>
