---
import type { Locale } from "@/data/site";

interface Props {
  locale: Locale;
  videoId: string;
  title: string;
}

const { locale, videoId, title } = Astro.props;
const copy = {
  es: {
    notice: "Al reproducir el vídeo se establecerá una conexión con YouTube. No se carga contenido externo antes de tu elección.",
    play: "Reproducir vídeo",
  },
  en: {
    notice: "Playing the video will connect to YouTube. No external content loads before you choose to play it.",
    play: "Play video",
  },
  fr: {
    notice: "La lecture de la vidéo établira une connexion avec YouTube. Aucun contenu externe n’est chargé avant votre choix.",
    play: "Lire la vidéo",
  },
}[locale];
---

<section
  class="video-consent"
  data-video-consent
  data-video-id={videoId}
  data-title={title}
>
  <div class="video-consent__content">
    <h2>{title}</h2>
    <p>
      {copy.notice}
    </p>
    <button class="button" type="button" data-video-play>
      {copy.play}
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-video-consent]").forEach((container) => {
    const button = container.querySelector<HTMLButtonElement>("[data-video-play]");
    button?.addEventListener("click", () => {
      const id = container.dataset.videoId;
      const title = container.dataset.title || "YouTube video";
      if (!id) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.tabIndex = -1;
      container.replaceChildren(iframe);
      iframe.focus();
    }, { once: true });
  });
</script>
