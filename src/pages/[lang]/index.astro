---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Picture from "@/components/Picture.astro";
import EditorialListing from "@/components/EditorialListing.astro";
import { getEditorialItems } from "@/lib/cms";
import { homePaths, locales, SITE_URL } from "@/data/site";

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const path = homePaths[locale];
const localizedPaths = homePaths;
const { items } = await getEditorialItems(locale);
const latest = items.sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6);
const copy = {
  es: {
    title: "Relatora Especial sobre extrema pobreza y derechos humanos",
    description: "Mandato, informes y actividades de Elena Carolina Díaz Galán, Relatora Especial sobre la extrema pobreza y los derechos humanos.",
    jobTitle: "Relatora Especial sobre la extrema pobreza y los derechos humanos",
    holderPath: "/es/titular-actual/",
    mandatePeriod: "Mandato actual · 2026–2029",
    heroTitle: "La pobreza es una cuestión de derechos.",
    heroIntro: "Elena Carolina Díaz Galán, Relatora Especial sobre la extrema pobreza y los derechos humanos.",
    mandatePath: "/es/mandato/",
    mandateAction: "Conocer el mandato",
    newsPath: "/es/actualidad/",
    newsAction: "Ver actualidad",
    principlesLabel: "Principios del mandato",
    principles: ["Dignidad", "Igualdad", "Rendición de cuentas"],
    explore: "Explorar",
    latestEyebrow: "El mandato en movimiento",
    latestTitle: "Actividad reciente",
    allNews: "Toda la actualidad",
    priority: "Prioridad temática",
    citiesTitle: "Ciudades y pobreza",
    citiesText: "Comprender cómo el territorio, la vivienda, los servicios y las desigualdades urbanas condicionan el ejercicio efectivo de los derechos humanos.",
    visitsPath: "/es/visitas/",
    visitsAction: "Explorar el trabajo sobre el terreno",
    quoteLabel: "Cita destacada",
    quote: "La pobreza la crea el ser humano. Y solo él puede erradicarla.",
    quoteAuthor: "Nelson Mandela",
    quoteSource: "https://archive.nelsonmandela.org/index.php/za-com-mr-s-760",
    knowledge: "Conocimiento compartido",
    initiativesTitle: "Iniciativas y colaboraciones",
    initiativesText: "Investigación, alianzas académicas y proyectos relacionados con la erradicación de la pobreza, claramente diferenciados de la actividad oficial del mandato.",
    initiativesPath: "/es/iniciativas/",
    initiativesAction: "Conocer las iniciativas",
  },
  en: {
    title: "Special Rapporteur on extreme poverty and human rights",
    description: "Mandate, reports and activities of Elena Carolina Díaz Galán, Special Rapporteur on extreme poverty and human rights.",
    jobTitle: "Special Rapporteur on extreme poverty and human rights",
    holderPath: "/en/current-holder/",
    mandatePeriod: "Current mandate · 2026–2029",
    heroTitle: "Poverty is a matter of rights.",
    heroIntro: "Elena Carolina Díaz Galán, Special Rapporteur on extreme poverty and human rights.",
    mandatePath: "/en/mandate/",
    mandateAction: "Explore the mandate",
    newsPath: "/en/news/",
    newsAction: "View latest news",
    principlesLabel: "Mandate principles",
    principles: ["Dignity", "Equality", "Accountability"],
    explore: "Explore",
    latestEyebrow: "The mandate in motion",
    latestTitle: "Recent activity",
    allNews: "All news",
    priority: "Thematic priority",
    citiesTitle: "Cities and poverty",
    citiesText: "Understanding how territory, housing, services and urban inequality shape the effective enjoyment of human rights.",
    visitsPath: "/en/visits/",
    visitsAction: "Explore field work",
    quoteLabel: "Featured quotation",
    quote: "Poverty is man-made and it can be overcome and eradicated by the actions of human beings.",
    quoteAuthor: "Nelson Mandela",
    quoteSource: "https://archive.nelsonmandela.org/index.php/za-com-mr-s-760",
    knowledge: "Shared knowledge",
    initiativesTitle: "Initiatives and collaborations",
    initiativesText: "Research, academic partnerships and projects related to poverty eradication, clearly distinguished from the mandate’s official activity.",
    initiativesPath: "/en/initiatives/",
    initiativesAction: "Explore initiatives",
  },
  fr: {
    title: "Rapporteuse spéciale sur l’extrême pauvreté et les droits de l’homme",
    description: "Mandat, rapports et activités d’Elena Carolina Díaz Galán, Rapporteuse spéciale sur l’extrême pauvreté et les droits de l’homme.",
    jobTitle: "Rapporteuse spéciale sur l’extrême pauvreté et les droits de l’homme",
    holderPath: "/fr/titulaire-actuelle/",
    mandatePeriod: "Mandat actuel · 2026–2029",
    heroTitle: "La pauvreté est une question de droits.",
    heroIntro: "Elena Carolina Díaz Galán, Rapporteuse spéciale sur l’extrême pauvreté et les droits de l’homme.",
    mandatePath: "/fr/mandat/",
    mandateAction: "Découvrir le mandat",
    newsPath: "/fr/actualites/",
    newsAction: "Voir les actualités",
    principlesLabel: "Principes du mandat",
    principles: ["Dignité", "Égalité", "Responsabilité"],
    explore: "Explorer",
    latestEyebrow: "Le mandat en action",
    latestTitle: "Activité récente",
    allNews: "Toutes les actualités",
    priority: "Priorité thématique",
    citiesTitle: "Villes et pauvreté",
    citiesText: "Comprendre comment le territoire, le logement, les services et les inégalités urbaines conditionnent l’exercice effectif des droits de l’homme.",
    visitsPath: "/fr/visites/",
    visitsAction: "Découvrir le travail de terrain",
    quoteLabel: "Citation à la une",
    quote: "La pauvreté est créée par l’être humain et peut être surmontée et éradiquée par l’action humaine.",
    quoteAuthor: "Nelson Mandela",
    quoteSource: "https://archive.nelsonmandela.org/index.php/za-com-mr-s-760",
    knowledge: "Connaissances partagées",
    initiativesTitle: "Initiatives et collaborations",
    initiativesText: "Recherche, partenariats universitaires et projets liés à l’éradication de la pauvreté, clairement distingués des activités officielles du mandat.",
    initiativesPath: "/fr/initiatives/",
    initiativesAction: "Découvrir les initiatives",
  },
}[locale];
const officialProfile = `https://www.ohchr.org/${locale}/special-procedures/sr-poverty/ms-elena-carolina-diaz-galan`;

const { title, description } = copy;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: title,
      url: `${SITE_URL}${path}`,
      inLanguage: locale,
      description,
    },
    {
      "@type": "Person",
      name: "Elena Carolina Díaz Galán",
      jobTitle: copy.jobTitle,
      url: `${SITE_URL}${copy.holderPath}`,
      sameAs: [officialProfile],
    },
  ],
};
---

<BaseLayout {locale} {title} {description} {path} {localizedPaths} {schema}>
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <Picture slug="elena-diaz-galan-portrait" alt="" width={2000} height={1126} eager responsive />
    </div>
    <div class="hero__content container">
      <div class="hero__copy">
        <p class="eyebrow">{copy.mandatePeriod}</p>
        <h1>{copy.heroTitle}</h1>
        <p class="hero__intro">{copy.heroIntro}</p>
        <div class="hero__actions">
          <a class="button" href={copy.mandatePath}>{copy.mandateAction}</a>
          <a class="button button--ghost" href={copy.newsPath}>{copy.newsAction}</a>
        </div>
      </div>
      <aside class="hero__principles" aria-label={copy.principlesLabel}>
        <span aria-hidden="true">01</span>
        {copy.principles.map((principle) => <p>{principle}</p>)}
      </aside>
    </div>
    <div class="hero__scroll" aria-hidden="true"><span></span>{copy.explore}</div>
  </section>

  <section class="section" aria-labelledby="latest-heading" data-pagefind-body>
    <div class="container">
      <header class="section-heading">
        <div>
          <p class="eyebrow">{copy.latestEyebrow}</p>
          <h2 id="latest-heading">{copy.latestTitle}</h2>
        </div>
        <a href={copy.newsPath}>{copy.allNews} →</a>
      </header>
      <EditorialListing items={latest} context="home" headingLevel={3} />
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="mandate-heading">
    <div class="container mandate-feature">
      <div>
        <p class="mandate-feature__number" aria-hidden="true">01</p>
        <p class="eyebrow">{copy.priority}</p>
      </div>
      <div>
        <h2 id="mandate-heading">{copy.citiesTitle}</h2>
        <p>{copy.citiesText}</p>
        <p><a href={copy.visitsPath}>{copy.visitsAction} →</a></p>
      </div>
    </div>
  </section>

  <section class="quote-band" aria-label={copy.quoteLabel}>
    <div class="container quote-band__inner">
      <span class="quote-band__mark" aria-hidden="true">“</span>
      <div>
        <blockquote>{copy.quote}</blockquote>
        <cite><a href={copy.quoteSource}>{copy.quoteAuthor}</a></cite>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="network-heading">
    <div class="container mandate-feature">
      <div>
        <p class="eyebrow">{copy.knowledge}</p>
        <h2 id="network-heading">{copy.initiativesTitle}</h2>
      </div>
      <div>
        <p>{copy.initiativesText}</p>
        <p><a href={copy.initiativesPath}>{copy.initiativesAction} →</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
