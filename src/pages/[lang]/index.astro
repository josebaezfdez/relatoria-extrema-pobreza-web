---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Picture from "@/components/Picture.astro";
import EditorialListing from "@/components/EditorialListing.astro";
import { getEditorialItems } from "@/lib/cms";
import { SITE_URL, type Locale } from "@/data/site";

export function getStaticPaths() {
  return [
    { params: { lang: "es" }, props: { locale: "es" as Locale } },
    { params: { lang: "en" }, props: { locale: "en" as Locale } },
  ];
}

const { locale } = Astro.props;
const isEs = locale === "es";
const path = `/${locale}/`;
const alternatePath = isEs ? "/en/" : "/es/";
const { items } = await getEditorialItems(locale);
const latest = items.sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6);
const title = isEs
  ? "Relatora Especial sobre extrema pobreza y derechos humanos"
  : "Special Rapporteur on extreme poverty and human rights";
const description = isEs
  ? "Mandato, informes y actividades de Elena Carolina Díaz Galán, Relatora Especial sobre la extrema pobreza y los derechos humanos."
  : "Mandate, reports and activities of Elena Carolina Díaz Galán, Special Rapporteur on extreme poverty and human rights.";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: title,
      url: `${SITE_URL}${path}`,
      inLanguage: locale,
      description,
    },
    {
      "@type": "Person",
      name: "Elena Carolina Díaz Galán",
      jobTitle: isEs
        ? "Relatora Especial sobre la extrema pobreza y los derechos humanos"
        : "Special Rapporteur on extreme poverty and human rights",
      url: `${SITE_URL}${isEs ? "/es/titular-actual/" : "/en/current-holder/"}`,
      sameAs: ["https://www.ohchr.org/es/special-procedures/sr-poverty/ms-elena-carolina-diaz-galan"],
    },
  ],
};
---

<BaseLayout {locale} {title} {description} {path} {alternatePath} {schema}>
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <Picture
        slug="elena-diaz-galan-portrait"
        alt=""
        width={2000}
        height={1126}
        eager
        responsive
      />
    </div>
    <div class="hero__content container">
      <div class="hero__copy">
        <p class="eyebrow">{isEs ? "Mandato actual · 2026–2029" : "Current mandate · 2026–2029"}</p>
        <h1>{isEs ? "La pobreza es una cuestión de derechos." : "Poverty is a matter of rights."}</h1>
        <p class="hero__intro">
          {isEs
            ? "Elena Carolina Díaz Galán, Relatora Especial sobre la extrema pobreza y los derechos humanos."
            : "Elena Carolina Díaz Galán, Special Rapporteur on extreme poverty and human rights."}
        </p>
        <div class="hero__actions">
          <a class="button" href={isEs ? "/es/mandato/" : "/en/mandate/"}>
            {isEs ? "Conocer el mandato" : "Explore the mandate"}
          </a>
          <a class="button button--ghost" href={isEs ? "/es/actualidad/" : "/en/news/"}>
            {isEs ? "Ver actualidad" : "View latest news"}
          </a>
        </div>
      </div>
      <aside class="hero__principles" aria-label={isEs ? "Principios del mandato" : "Mandate principles"}>
        <span aria-hidden="true">01</span>
        <p>{isEs ? "Dignidad" : "Dignity"}</p>
        <p>{isEs ? "Igualdad" : "Equality"}</p>
        <p>{isEs ? "Rendición de cuentas" : "Accountability"}</p>
      </aside>
    </div>
    <div class="hero__scroll" aria-hidden="true">
      <span></span>
      {isEs ? "Explorar" : "Explore"}
    </div>
  </section>

  <section class="section" aria-labelledby="latest-heading" data-pagefind-body>
    <div class="container">
      <header class="section-heading">
        <div>
          <p class="eyebrow">{isEs ? "El mandato en movimiento" : "The mandate in motion"}</p>
          <h2 id="latest-heading">{isEs ? "Actividad reciente" : "Recent activity"}</h2>
        </div>
        <a href={isEs ? "/es/actualidad/" : "/en/news/"}>
          {isEs ? "Toda la actualidad" : "All news"} →
        </a>
      </header>
      <EditorialListing items={latest} context="home" headingLevel={3} />
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="mandate-heading">
    <div class="container mandate-feature">
      <div>
        <p class="mandate-feature__number" aria-hidden="true">01</p>
        <p class="eyebrow">{isEs ? "Prioridad temática" : "Thematic priority"}</p>
      </div>
      <div>
        <h2 id="mandate-heading">{isEs ? "Ciudades y pobreza" : "Cities and poverty"}</h2>
        <p>
          {isEs
            ? "Comprender cómo el territorio, la vivienda, los servicios y las desigualdades urbanas condicionan el ejercicio efectivo de los derechos humanos."
            : "Understanding how territory, housing, services and urban inequality shape the effective enjoyment of human rights."}
        </p>
        <p><a href={isEs ? "/es/visitas/" : "/en/visits/"}>{isEs ? "Explorar el trabajo sobre el terreno" : "Explore field work"} →</a></p>
      </div>
    </div>
  </section>

  <section class="quote-band" aria-label={isEs ? "Cita destacada" : "Featured quotation"}>
    <div class="container quote-band__inner">
      <span class="quote-band__mark" aria-hidden="true">“</span>
      <div>
        <blockquote>
          {isEs
            ? "La pobreza la crea el ser humano. Y solo él puede erradicarla."
            : "Poverty is created by human beings. And only human beings can eradicate it."}
        </blockquote>
        <cite>Elena Carolina Díaz Galán</cite>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="network-heading">
    <div class="container mandate-feature">
      <div>
        <p class="eyebrow">{isEs ? "Conocimiento compartido" : "Shared knowledge"}</p>
        <h2 id="network-heading">{isEs ? "Iniciativas y colaboraciones" : "Initiatives and collaborations"}</h2>
      </div>
      <div>
        <p>
          {isEs
            ? "Investigación, alianzas académicas y proyectos relacionados con la erradicación de la pobreza, claramente diferenciados de la actividad oficial del mandato."
            : "Research, academic partnerships and projects related to poverty eradication, clearly distinguished from the mandate’s official activity."}
        </p>
        <p><a href={isEs ? "/es/iniciativas/" : "/en/initiatives/"}>{isEs ? "Conocer las iniciativas" : "Explore initiatives"} →</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
