---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import EditorialListing from "@/components/EditorialListing.astro";
import Picture from "@/components/Picture.astro";
import SearchBox from "@/components/SearchBox.astro";
import VideoConsent from "@/components/VideoConsent.astro";
import { editorialItems, itemsFor, localizedPathsFor, staticPages, type EditorialItem, type StaticPage } from "@/data/content";
import { getEditorialItems } from "@/lib/cms";
import { locales, searchPaths, SITE_URL, type Locale, type LocalizedPaths } from "@/data/site";

type RouteProps =
  | { kind: "static"; locale: Locale; page: StaticPage; localizedPaths: LocalizedPaths }
  | { kind: "item"; locale: Locale; item: EditorialItem; localizedPaths: LocalizedPaths }
  | { kind: "search"; locale: Locale; path: string; localizedPaths: LocalizedPaths };

export async function getStaticPaths() {
  const staticRoutes = staticPages.map((page) => ({
    params: {
      lang: page.locale,
      slug: page.path.replace(`/${page.locale}/`, "").replace(/\/$/, ""),
    },
    props: { kind: "static" as const, locale: page.locale, page, localizedPaths: localizedPathsFor(page, staticPages) },
  }));
  const remoteCollections = await Promise.all(locales.map((locale) => getEditorialItems(locale)));
  const cmsItems = remoteCollections.flatMap((collection) => collection.items);
  const routedItems = cmsItems.length ? cmsItems : editorialItems;
  const itemRoutes = routedItems.map((item) => ({
    params: {
      lang: item.locale,
      slug: item.path.replace(`/${item.locale}/`, "").replace(/\/$/, ""),
    },
    props: { kind: "item" as const, locale: item.locale, item, localizedPaths: localizedPathsFor(item, routedItems) },
  }));
  const searchRoutes = locales.map((locale) => ({
    params: { lang: locale, slug: searchPaths[locale].replace(`/${locale}/`, "").replace(/\/$/, "") },
    props: { kind: "search" as const, locale, path: searchPaths[locale], localizedPaths: searchPaths },
  }));
  return [...staticRoutes, ...itemRoutes, ...searchRoutes];
}

const props = Astro.props as RouteProps;
const { locale } = props;
const isStatic = props.kind === "static";
const isItem = props.kind === "item";
const isSearch = props.kind === "search";
const pageCopy = {
  es: {
    searchTitle: "Buscar",
    searchDescription: "Busca informes, visitas, eventos y noticias del mandato.",
    resources: "Recursos y fuentes",
    archive: "Archivo del mandato",
    gallery: "Galería de imágenes",
  },
  en: {
    searchTitle: "Search",
    searchDescription: "Search mandate reports, visits, events and news.",
    resources: "Resources and sources",
    archive: "Mandate archive",
    gallery: "Image gallery",
  },
  fr: {
    searchTitle: "Recherche",
    searchDescription: "Recherchez des rapports, des visites, des événements et des actualités du mandat.",
    resources: "Ressources et sources",
    archive: "Archives du mandat",
    gallery: "Galerie d’images",
  },
}[locale];
const title = isStatic ? props.page.title : isItem ? props.item.title : pageCopy.searchTitle;
const description = isStatic
  ? props.page.description
  : isItem
    ? props.item.summary
    : pageCopy.searchDescription;
const path = isStatic ? props.page.path : isItem ? props.item.path : props.path;
const localizedPaths = props.localizedPaths;
const listingItems = isStatic && props.page.listing ? itemsFor(locale, props.page.listing) : [];
const image = isItem && props.item.image ? `/media/${props.item.image}/cover.jpg` : undefined;
const schemaType = isItem
  ? props.item.type === "event"
    ? "Event"
    : props.item.type === "report"
      ? "Report"
      : props.item.type === "press_release"
        ? "NewsArticle"
        : "Article"
  : null;
const schema = isItem
  ? {
      "@context": "https://schema.org",
      "@type": schemaType,
      name: props.item.title,
      headline: props.item.title,
      description: props.item.summary,
      datePublished: props.item.date,
      startDate: props.item.type === "event" ? props.item.date : undefined,
      location: props.item.location ? { "@type": "Place", name: props.item.location } : undefined,
      image: image ? new URL(image, SITE_URL).toString() : undefined,
      url: new URL(path, SITE_URL).toString(),
      inLanguage: locale,
      author: { "@type": "Person", name: "Elena Carolina Díaz Galán" },
    }
  : undefined;
---

<BaseLayout
  {locale}
  {title}
  {description}
  {path}
  {localizedPaths}
  {image}
  type={isItem ? "article" : "website"}
  published={isItem ? props.item.date : undefined}
  {schema}
>
  <Breadcrumbs {locale} current={title} />

  {isStatic && (
    <>
      <header class="page-header">
        <div class="page-header__inner container">
          <div>
            {props.page.eyebrow && <p class="eyebrow">{props.page.eyebrow}</p>}
            <h1 data-pagefind-meta="title">{props.page.title}</h1>
          </div>
          <p class="page-header__description">{props.page.description}</p>
        </div>
      </header>
      {props.page.body && <article class="prose" data-pagefind-body set:html={props.page.body} />}
      {props.page.listing && (
        <section class="section listing-section" aria-label={props.page.title} data-pagefind-ignore>
          <div class="container">
            <EditorialListing items={listingItems} context="archive" headingLevel={2} />
          </div>
        </section>
      )}
    </>
  )}

  {isItem && (
    <>
      <article data-pagefind-body>
        <header class="article-header">
          <div class="article-header__grid container">
            <div>
              <p class="eyebrow">{props.item.eyebrow}</p>
              <h1 data-pagefind-meta="title">{props.item.title}</h1>
              <p class="article-header__summary">{props.item.summary}</p>
              <ul class="article-header__meta">
                <li><time datetime={props.item.date}>{props.item.displayDate}</time></li>
                {props.item.location && <li>{props.item.location}</li>}
              </ul>
            </div>
            {props.item.image && (
              <figure class="article-header__image">
                <Picture
                  slug={props.item.image}
                  alt={props.item.imageAlt || ""}
                  width={props.item.imageWidth}
                  height={props.item.imageHeight}
                  eager
                />
              </figure>
            )}
          </div>
        </header>
        <div class="prose" set:html={props.item.body} />
        {props.item.gallery?.length && (
          <section class="media-gallery section" aria-labelledby="article-gallery-title" data-pagefind-ignore>
            <div class="container">
              <header class="media-gallery__header">
                <p class="eyebrow">{pageCopy.gallery}</p>
                <h2 id="article-gallery-title">{pageCopy.gallery}</h2>
              </header>
              <ul class="media-gallery__grid">
                {props.item.gallery.map((asset) => (
                  <li class="media-gallery__item">
                    <figure>
                      <Picture
                        slug={asset.slug}
                        alt=""
                        width={asset.width}
                        height={asset.height}
                        responsive
                        sizes="(max-width: 46rem) 100vw, 46vw"
                      />
                      <figcaption>{asset.alt}</figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
        {(props.item.download || props.item.audio || props.item.links?.length) && (
          <section class="prose prose--resources" aria-labelledby="resources-title">
            <h2 id="resources-title">{pageCopy.resources}</h2>
            <ul class="resource-list">
              {props.item.download && <li><a href={props.item.download.href}>{props.item.download.label}<span aria-hidden="true">↓</span></a></li>}
              {props.item.audio && <li><a href={props.item.audio.href}>{props.item.audio.label}<span aria-hidden="true">↗</span></a></li>}
              {props.item.links?.map((link) => <li><a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a></li>)}
            </ul>
          </section>
        )}
        {props.item.video && (
          <div class="container section">
            <VideoConsent locale={locale} videoId={props.item.video.id} title={props.item.video.title} />
          </div>
        )}
      </article>
    </>
  )}

  {isSearch && (
    <>
      <header class="page-header">
        <div class="page-header__inner container">
          <div>
            <p class="eyebrow">{pageCopy.archive}</p>
            <h1>{title}</h1>
          </div>
          <p class="page-header__description">{description}</p>
        </div>
      </header>
      <SearchBox {locale} />
    </>
  )}
</BaseLayout>
