---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import EditorialListing from "@/components/EditorialListing.astro";
import EditorialArchive from "@/components/EditorialArchive.astro";
import TopicHighlights from "@/components/TopicHighlights.astro";
import HostedVideo from "@/components/HostedVideo.astro";
import Picture from "@/components/Picture.astro";
import { editorialItems, itemsForPage, localizedPathsFor, staticPages, type EditorialItem, type StaticPage } from "@/data/content";
import { archiveCopy, categories, topics, categoryHref, topicHref, newsPaths, reportPaths, relatedItems, formatsFor } from "@/data/editorial-taxonomy";
import { pageOutline } from "@/lib/page-outline";
import { getEditorialItems } from "@/lib/cms";
import { exactEditorialDate } from "@/lib/editorial-dates";
import { locales, SITE_URL, type Locale, type LocalizedPaths } from "@/data/site";

type RouteProps =
  | { kind: "static"; locale: Locale; page: StaticPage; localizedPaths: LocalizedPaths; items: EditorialItem[] }
  | { kind: "item"; locale: Locale; item: EditorialItem; localizedPaths: LocalizedPaths; items: EditorialItem[] };

export async function getStaticPaths() {
  const remoteCollections = await Promise.all(locales.map((locale) => getEditorialItems(locale)));
  const cmsItems = remoteCollections.flatMap((collection) => collection.items);
  const routedItems = cmsItems.length ? cmsItems : editorialItems;
  const staticRoutes = staticPages.map((page) => ({
    params: {
      lang: page.locale,
      slug: page.path.replace(`/${page.locale}/`, "").replace(/\/$/, ""),
    },
    props: { kind: "static" as const, locale: page.locale, page, localizedPaths: localizedPathsFor(page, staticPages), items: routedItems.filter((item) => item.locale === page.locale) },
  }));
  const itemRoutes = routedItems.map((item) => ({
    params: {
      lang: item.locale,
      slug: item.path.replace(`/${item.locale}/`, "").replace(/\/$/, ""),
    },
    props: { kind: "item" as const, locale: item.locale, item, localizedPaths: localizedPathsFor(item, routedItems), items: routedItems.filter((candidate) => candidate.locale === item.locale) },
  }));
  return [...staticRoutes, ...itemRoutes];
}

const props = Astro.props as RouteProps;
const { locale } = props;
const isStatic = props.kind === "static";
const isItem = props.kind === "item";
const pageCopy = {
  es: {
    resources: "Recursos y fuentes",
    gallery: "Galería de imágenes",
    related: "Actividades y materiales relacionados",
    details: "Ver la ficha del vídeo",
    publishedReports: "Informes publicados",
    exploreSection: "Explorar esta sección",
  },
  en: {
    resources: "Resources and sources",
    gallery: "Image gallery",
    related: "Related activities and resources",
    details: "View the video article",
    publishedReports: "Published reports",
    exploreSection: "Explore this section",
  },
  fr: {
    resources: "Ressources et sources",
    gallery: "Galerie d’images",
    related: "Activités et ressources associées",
    details: "Voir la fiche de la vidéo",
    publishedReports: "Rapports publiés",
    exploreSection: "Explorer cette rubrique",
  },
}[locale];
const title = isStatic ? props.page.title : props.item.title;
const description = isStatic ? props.page.description : props.item.summary;
const path = isStatic ? props.page.path : props.item.path;
const localizedPaths = props.localizedPaths;
const taxonomy = archiveCopy[locale];
const isNews = isStatic && props.page.id === `news-${locale}`;
const outline = isStatic && /^(mandate|holder)-(es|en|fr)$/.test(props.page.id)
  ? pageOutline(props.page.body || "") : undefined;
const related = isItem ? relatedItems(props.item, props.items) : [];
const parents = isItem
  ? props.item.category === "reports" ? [{ label: categories.reports[locale], href: reportPaths[locale] }]
    : [{ label: locale === "es" ? "Actualidad" : locale === "en" ? "News" : "Actualités", href: newsPaths[locale] }, ...(props.item.category ? [{ label: categories[props.item.category][locale], href: categoryHref(locale, props.item.category) }] : [])]
  : isStatic && (props.page.topic || (props.page.listing && !["news", "report"].includes(props.page.listing)))
    ? [{ label: locale === "es" ? "Actualidad" : locale === "en" ? "News" : "Actualités", href: newsPaths[locale] }] : [];
const { featuredItem, items: listingItems } = isStatic && props.page.listing
  ? itemsForPage(props.page, props.items)
  : { featuredItem: undefined, items: [] };
const imageItem = isItem ? props.item : featuredItem;
const image = imageItem?.image ? `/media/${imageItem.image}/cover.jpg` : undefined;
const exactDate = isItem ? exactEditorialDate(props.item.date) : undefined;
const schemaType = isItem
  ? props.item.type === "event"
    ? "Event"
    : props.item.type === "report"
      ? "Report"
      : props.item.type === "press_release"
        ? "NewsArticle"
        : "Article"
  : null;
const schema = isItem
  ? {
      "@context": "https://schema.org",
      "@type": schemaType,
      name: props.item.title,
      headline: props.item.title,
      description: props.item.summary,
      datePublished: exactDate,
      startDate: props.item.type === "event" ? exactDate : undefined,
      endDate: props.item.type === "event" && props.item.endDate ? exactEditorialDate(props.item.endDate) : undefined,
      location: props.item.location ? { "@type": "Place", name: props.item.location } : undefined,
      image: image ? new URL(image, SITE_URL).toString() : undefined,
      url: new URL(path, SITE_URL).toString(),
      inLanguage: locale,
      author: { "@type": "Person", name: "Elena Carolina Díaz Galán" },
    }
  : undefined;
---

<BaseLayout
  {locale}
  {title}
  {description}
  {path}
  {localizedPaths}
  {image}
  type={isItem ? "article" : "website"}
  published={exactDate}
  {schema}
>
  <Breadcrumbs {locale} current={title} {parents} />

  {isStatic && (
    <>
      <header class:list={["page-header", { "page-header--archive": Boolean(props.page.listing) }]}>
        <div class="page-header__inner container">
          <div>
            {props.page.eyebrow && <p class="eyebrow">{props.page.eyebrow}</p>}
            <h1>{props.page.title}</h1>
          </div>
          <p class="page-header__description">{props.page.description}{isNews && <a class="page-header__archive-link" href="#archive">{taxonomy.fullArchive} <span aria-hidden="true">↓</span></a>}</p>
        </div>
      </header>
      {outline && outline.headings.length >= 3 && <nav class="page-outline container" aria-label={taxonomy.onPage}><p class="eyebrow">{taxonomy.onPage}</p><ol>{outline.headings.map((heading) => <li><a href={`#${heading.id}`}>{heading.title}</a></li>)}</ol></nav>}
      {props.page.body && <article class:list={["prose", { "prose--topic": Boolean(props.page.topic) }]} set:html={outline?.html || props.page.body} />}
      {isNews && (
        <TopicHighlights {locale} items={props.items} />
      )}
      {featuredItem?.video && (
        <div class="container section">
          <HostedVideo locale={locale} {...featuredItem.video} />
          <p><a href={featuredItem.path}>{pageCopy.details} →</a></p>
        </div>
      )}
      {props.page.listing && listingItems.length > 0 && (
        <EditorialArchive items={listingItems} {locale} label={isNews ? undefined : props.page.eyebrow || props.page.title} heading={props.page.topic ? pageCopy.related : isNews ? undefined : props.page.listing === "report" ? pageCopy.publishedReports : pageCopy.exploreSection} />
      )}
    </>
  )}

  {isItem && (
    <>
      <article>
        <header class="article-header">
          <div class:list={["article-header__grid", "container", !props.item.image && "article-header__grid--text"]}>
            <div>
              <p class="eyebrow">{props.item.eyebrow}</p>
              <h1>{props.item.title}</h1>
              <p class="article-header__summary">{props.item.summary}</p>
              <ul class="article-header__meta">
                <li><time datetime={props.item.date}>{props.item.displayDate}</time></li>
                {props.item.location && <li>{props.item.location}</li>}
              </ul>
            </div>
            {props.item.image && (
              <figure class:list={["article-header__image", props.item.imagePresentation === "document" && "article-header__image--document"]}>
                <Picture
                  slug={props.item.image}
                  alt={props.item.imageAlt || ""}
                  width={props.item.imageWidth}
                  height={props.item.imageHeight}
                  eager
                />
              </figure>
            )}
          </div>
        </header>
        <nav class="article-taxonomy container" aria-label={taxonomy.navigation}>
          {props.item.category && <a class="category-badge" href={categoryHref(locale, props.item.category)}>{categories[props.item.category][locale]}</a>}
          {props.item.topics?.length ? <ul class="topic-tags">{props.item.topics.map((topic) => <li><a href={topicHref(locale, topic)}>{topics[topic][locale]}</a></li>)}</ul> : null}
          {formatsFor(props.item).length > 0 && <ul class="format-badges">{formatsFor(props.item).map((format) => <li>{taxonomy[format]}</li>)}</ul>}
        </nav>
        <div class="prose" set:html={props.item.body} />
        {props.item.video && (
          <div class="container section">
            <HostedVideo
              locale={locale}
              title={props.item.video.title}
              src={props.item.video.src}
              poster={props.item.video.poster}
              width={props.item.video.width}
              height={props.item.video.height}
            />
          </div>
        )}
        {props.item.gallery?.length && (
          <section class="media-gallery section" aria-labelledby="article-gallery-title">
            <div class="container">
              <header class="media-gallery__header">
                <p class="eyebrow">{pageCopy.gallery}</p>
                <h2 id="article-gallery-title">{pageCopy.gallery}</h2>
              </header>
              <ul class="media-gallery__grid">
                {props.item.gallery.map((asset) => (
                  <li class="media-gallery__item">
                    <figure>
                      <Picture
                        slug={asset.slug}
                        alt=""
                        width={asset.width}
                        height={asset.height}
                        responsive
                        sizes="(max-width: 46rem) 100vw, 46vw"
                      />
                      <figcaption>{asset.alt}</figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
        {(props.item.download || props.item.audio || props.item.links?.length) && (
          <section class="prose prose--resources" aria-labelledby="resources-title">
            <h2 id="resources-title">{pageCopy.resources}</h2>
            <ul class="resource-list">
              {props.item.download && <li><a href={props.item.download.href}>{props.item.download.label}<span aria-hidden="true">↓</span></a></li>}
              {props.item.audio && <li><a href={props.item.audio.href}>{props.item.audio.label}<span aria-hidden="true">↗</span></a></li>}
              {props.item.links?.map((link) => <li><a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a></li>)}
            </ul>
          </section>
        )}
      </article>
      {related.length > 0 && <section class="related-content container" aria-labelledby="related-content-heading"><header class="section-heading"><h2 id="related-content-heading">{taxonomy.related}</h2></header><EditorialListing items={related} context="archive" headingLevel={3} /></section>}
    </>
  )}

</BaseLayout>
